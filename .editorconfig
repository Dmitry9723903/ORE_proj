root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md}]
indent_size = 2

[*.{csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
# --- Личный стандарт: пространства имён блочные, не файловые ---
csharp_style_namespace_declarations = block_scoped:error

# --- Встроенные псевдонимы вместо имён BCL ---
dotnet_style_predefined_type_for_locals_parameters_members = true:error
dotnet_style_predefined_type_for_member_access = true:error

# --- Без this. ---
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error

# --- Именование: приватные поля _camelCase, типы и члены PascalCase ---
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

dotnet_naming_rule.types_pascal.severity = error
dotnet_naming_rule.types_pascal.symbols = types_and_members
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_symbols.types_and_members.applicable_kinds = class,struct,interface,enum,delegate,method,property,event
dotnet_naming_style.pascal.capitalization = pascal_case

# --- StyleCop: что выключено и почему ---
# SA1633 файловый заголовок-баннер: не требуется, авторство ведётся git-историей
dotnet_diagnostic.SA1633.severity = none
# SA1101 префикс this.: противоречит личному стандарту
dotnet_diagnostic.SA1101.severity = none
# SA1200 using внутри namespace: используем using сверху файла
dotnet_diagnostic.SA1200.severity = none
# SA1309 поле с префиксом _: это и есть наше правило именования
dotnet_diagnostic.SA1309.severity = none
# SA1516 пустая строка между элементами: спорит с форматированием IDE
dotnet_diagnostic.SA1516.severity = none
# SA1124 «не используйте регионы»: прямо противоречит личному стандарту,
# который требует группировать члены типа регионами по видимости
dotnet_diagnostic.SA1124.severity = none
# SA1623 «summary свойства начинается с Gets»: документация ведётся
# по-русски, английский шаблон неприменим
dotnet_diagnostic.SA1623.severity = none
# SA1642 «summary конструктора начинается со стандартного текста»: то же
dotnet_diagnostic.SA1642.severity = none

# --- Анализаторы .NET: что выключено и почему ---
# CA1000 «не объявляйте статические члены на обобщённых типах».
# Правило верное по мотиву: вызов Result<T,F>.Success требует писать оба
# параметра типа. Штатный обход — промежуточные типы SuccessResult<T> и
# FailureResult<F> с неявным приведением; он даёт Result.Success(value) с
# выводом типа, но стоит четырёх типов и двух приведений.
# Потребителей у Result сейчас ноль, и вводить машинерию впрок нельзя.
# Условие возврата: если многословие возврата станет заметно на вехах B2–B5,
# промежуточные типы вводятся тогда — с уже накопленным свидетельством.
dotnet_diagnostic.CA1000.severity = none

# --- Документация публичной поверхности обязательна ---
dotnet_diagnostic.SA1600.severity = error
dotnet_diagnostic.CS1591.severity = error

# --- Миграции: порождённый код ---
# Файлы миграций пишет инструмент, а не человек. Приводить их к нашему
# стилю руками бессмысленно: следующий вызов dotnet ef вернёт своё
# оформление, и разница будет всплывать в каждом изменении схемы.
# Помечаем как порождённые — анализаторы к порождённому не применяются.
[**/Persistence/Migrations/*.cs]
generated_code = true
